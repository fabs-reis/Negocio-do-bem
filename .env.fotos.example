# Configuração da rotina de fotos (npm run fotos:instagram), que roda no seu
# computador. Copie para .env.fotos e preencha. Nunca faça commit do .env.fotos.

# Endereço do site que recebe as fotos, sem barra no final.
FOTOS_SITE_URL="https://www.negociodobem.com"

# O mesmo valor de FOTOS_TOKEN configurado no Worker do Cloudflare (no mínimo
# 32 caracteres).
# Gere um com: openssl rand -hex 32
FOTOS_TOKEN=""

# Token do usuário do sistema "Negócio do Bem" no portfólio da Meta, com as
# permissões instagram_basic, instagram_manage_insights, pages_read_engagement
# e pages_show_list. Gerado em business.facebook.com > Usuários do sistema.
META_ACCESS_TOKEN=""

# ID da conta do Instagram que faz as consultas (a conta profissional ligada à
# Página do Facebook). Não é segredo.
META_IG_USER_ID="17841425090230055"

# Opcionais:
# META_GRAPH_VERSION="v26.0"
# FOTOS_PASTA_MANUAL="fotos-manuais"
# FOTOS_LIMITE="100"
