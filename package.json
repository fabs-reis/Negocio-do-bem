{
  "name": "negocio-do-bem",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "sh scripts/cloudflare-build.sh",
    "cf:preview": "sh scripts/cloudflare-preview.sh",
    "preview:cloudflare": "DEPLOY_ENV=preview npm run cf:build && DEPLOY_ENV=preview opennextjs-cloudflare preview",
    "deploy:cloudflare": "DEPLOY_ENV=production npm run cf:build && DEPLOY_ENV=production opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "banco:copiar": "sh scripts/copiar-banco.sh",
    "fotos:instagram": "tsx scripts/fotos-instagram.ts",
    "fotos:agendar": "sh scripts/agendar-fotos.sh",
    "fotos:para-r2": "tsx scripts/fotos-para-r2.ts",
    "municipios:atualizar": "tsx scripts/municipios-ibge.ts",
    "cidades:corrigir": "tsx scripts/corrigir-cidades.ts",
    "cidades:fotos": "tsx scripts/fotos-das-cidades.ts",
    "moderacao": "tsx scripts/moderacao.ts",
    "marca:icones": "tsx scripts/gerar-icones.ts",
    "marca:fontes": "tsx scripts/gerar-fontes.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@next/third-parties": "16.4.3",
    "@opennextjs/cloudflare": "1.20.14",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pg-cloudflare": "1.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=24"
  }
}
