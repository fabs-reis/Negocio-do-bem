# Copie para .env e ajuste. Nunca faça commit do .env.

# Banco Postgres (o docker-compose.yml sobe um com estes dados)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/negocio_do_bem?schema=public"

# Endereço público do site, sem barra no final. Usado no retorno do login do Instagram.
APP_URL="http://localhost:3000"

# E-mails que viram moderadores ao entrar (separados por vírgula).
ADMIN_EMAILS="voce@exemplo.com"

# Vercel Blob, onde ficam as fotos. Em produção é obrigatório; no seu computador,
# vazio, as fotos ficam em public/enviados.
BLOB_READ_WRITE_TOKEN=""

# Sem nada abaixo preenchido, o dono assume o perfil enviando os dados do negócio
# (CNPJ, site e contato) e a moderação aprova.

# --- Opcional: código por DM ---
# @ oficial do Negócio do Bem no Instagram, que recebe as DMs com código de verificação.
# Vazio, o código por DM fica desligado.
INSTAGRAM_PERFIL_OFICIAL=""

# --- Opcional: "Entrar com Instagram" (Instagram API with Instagram Login) ---
# Preencha depois de criar o app na Meta. Sem estas variáveis o botão fica escondido.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_GRAPH_VERSION="v25.0"

# --- Opcional: confirmação automática do código enviado por DM ---
# Token de acesso da conta oficial (INSTAGRAM_PERFIL_OFICIAL), com as permissões
# instagram_business_basic e instagram_business_manage_messages.
INSTAGRAM_ACCESS_TOKEN=""
# Texto livre que você também informa no painel da Meta ao cadastrar o webhook.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
