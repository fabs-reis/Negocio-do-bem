# Copie para .env e ajuste. Nunca faça commit do .env.

# Banco Postgres (o docker-compose.yml sobe um com estes dados)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/negocio_do_bem?schema=public"

# Endereço público do site, sem barra no final. Usado no retorno do login do
# Google e do Instagram.
APP_URL="http://localhost:3000"

# --- Opcional: "Continuar com o Google" em /entrar e /cadastrar ---
# Cliente OAuth do tipo "Aplicativo da Web" no Google Cloud, com a URI de
# redirecionamento <APP_URL>/api/google/retorno. Sem as duas, o botão fica escondido.
# No Cloudflare, o GOOGLE_CLIENT_SECRET vai como secret.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Limite de tentativas de login e cadastro por IP. Nos deploys Cloudflare, o
# cf-connecting-ip é usado quando CLOUDFLARE_DEPLOY=1.
# Em outra hospedagem, os cabeçalhos de IP são ignorados (qualquer visitante pode
# escrevê-los) e todos dividem um contador só. Se há um proxy seu na frente do
# site, que escreve o x-forwarded-for e é o único caminho até o site, ponha 1.
AUTENTICACAO_PROXY_CONFIAVEL=""

# Google Analytics (ID de medição, ex.: G-XXXXXXXXXX). Configure só na produção:
# vazio, o Analytics não carrega.
NEXT_PUBLIC_GA_ID=""

# Códigos de verificação do Google Search Console e do Bing Webmaster Tools: só o
# valor do content da meta tag. Configure só na produção; vazios, as meta tags
# não aparecem.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# URL pública do bucket Cloudflare R2 (domínio próprio em produção; r2.dev pode ser usado em POC).
# No Cloudflare, configure também o binding UPLOADS no Worker. Vazio localmente,
# as fotos ficam em public/enviados.
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Ambiente de deploy: production ou preview. Controla migrações, indexação e e-mail.
DEPLOY_ENV=""
# Ative só nos deploys Cloudflare para ler o IP confiável cf-connecting-ip.
CLOUDFLARE_DEPLOY=""

# Rotina de fotos do Instagram: token que o script local (npm run fotos:instagram)
# usa para enviar as fotos. No mínimo 32 caracteres; gere com: openssl rand -hex 32.
# Vazio, a rota /api/fotos-instagram responde 404.
FOTOS_TOKEN=""

# --- Opcional: prévia do Instagram no cadastro (/participar) ---
# Os mesmos valores do .env.fotos: o token do usuário do sistema na Meta e o ID da
# conta do Instagram que faz as consultas. Com eles, o @ digitado mostra a foto, o
# nome e o site do perfil, e a foto vira a foto do negócio. Vazios, o cadastro segue
# sem prévia.
META_ACCESS_TOKEN=""
META_IG_USER_ID=""
# META_GRAPH_VERSION="v26.0"

# --- Opcional: avisos por e-mail (Resend) ---
# Avisos para quem pediu uma reivindicação, para a moderação e para os donos.
# Sem a chave e o remetente, ninguém recebe e-mail. Configure só em produção:
# nos previews o envio fica desligado mesmo com as variáveis.
# Chave do Resend, com permissão só de envio.
RESEND_API_KEY=""
# Remetente, de um domínio verificado no Resend. Ex.: "Negócio do Bem <avisos@negociodobem.com>"
EMAIL_REMETENTE=""
# Para onde vão as respostas. Vazio, elas vão para o remetente. Ex.: "ola@negociodobem.com"
EMAIL_RESPOSTA=""

# --- Opcional: Instagram do projeto ---
# @ do Negócio do Bem no Instagram. Vai nos dados estruturados da página inicial.
INSTAGRAM_PERFIL_OFICIAL=""

# Sem o "Entrar com Instagram", o dono assume o perfil enviando os dados do negócio
# (CNPJ, site e contato): na hora, se o negócio ainda não tem dono.

# --- Opcional: "Entrar com Instagram" (Instagram API with Instagram Login) ---
# Preencha depois de criar o app na Meta. Sem estas variáveis o botão fica escondido.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_GRAPH_VERSION="v25.0"
